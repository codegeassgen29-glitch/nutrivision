# .env.example
# ---------------------------------------------------------
# This is a TEMPLATE, not the real file. It shows every
# environment variable the project needs, WITHOUT real secrets.
# You copy this to a file named ".env" and fill in real values.
# ".env" itself is git-ignored so secrets never get committed.
# ---------------------------------------------------------

# --- Database ---
POSTGRES_DB=nutrivision
POSTGRES_USER=nutrivision_user
POSTGRES_PASSWORD=changeme_use_a_real_password

# --- Backend security (used starting Milestone 3) ---
JWT_SECRET_KEY=changeme_use_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
